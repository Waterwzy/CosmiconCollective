# 复制本文件为 .env 并填入你的配置（.env 已被 gitignore，勿提交真实密钥）

# OpenAI 兼容端点、密钥、模型；逗号分隔多个即按顺序自动回退
LLM_BASE_URLS=https://your-endpoint-a.com/v1,https://your-endpoint-b.com/v1
LLM_API_KEYS=sk-key-a,sk-key-b
LLM_MODELS=model-a,model-b

# 可选：请求超时（秒）、单端点重试次数、指数退避基数（秒）
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=1.0
